Options -Indexes
DirectoryIndex index.html

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prefer Brotli when the server supports it.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS \
        text/html \
        text/plain \
        text/css \
        text/javascript \
        application/javascript \
        application/json \
        application/manifest+json \
        image/svg+xml
</IfModule>

# Gzip fallback when Brotli is not available.
<IfModule !mod_brotli.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE \
            text/html \
            text/plain \
            text/css \
            text/javascript \
            application/javascript \
            application/json \
            application/manifest+json \
            image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_headers.c>
    # Versioned CSS/JS URLs can be cached aggressively.
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images change less often, but keep a shorter cache lifetime because
    # their filenames are currently not versioned.
    <FilesMatch "\.(?:png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # The manifest may be refreshed periodically.
    <Files "manifest.webmanifest">
        Header set Cache-Control "public, max-age=3600"
    </Files>

    # Always revalidate the HTML shell so new deployments are discovered.
    <Files "index.html">
        Header set Cache-Control "no-cache, must-revalidate"
    </Files>

    # The service worker itself must never get stuck behind a long browser cache.
    <Files "service-worker.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>
</IfModule>
